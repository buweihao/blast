---
const links = [
  { href: '/', label: '首页' },
  { href: '/products/', label: '产品' },
  { href: '/about/', label: '关于' },
  { href: '/contact/', label: '联系' },
];
---

<header class="sticky top-0 z-30 border-b border-ink/10 bg-paper/90 backdrop-blur">
  <nav class="container flex min-h-16 items-center justify-between gap-6">
    <a href="/" class="text-xl font-black text-ink no-underline">buweihao</a>
    <div class="flex flex-wrap items-center justify-end gap-1">
      {links.map((link) => <a class="rounded-full px-3 py-2 text-sm font-semibold text-muted no-underline hover:bg-mist hover:text-ink" href={link.href}>{link.label}</a>)}
    </div>
  </nav>
</header>

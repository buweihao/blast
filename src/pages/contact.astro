---
import Layout from '@layouts/Layout.astro';
---

<Layout title="联系 | buweihao" description="联系 buweihao 获取产品合作与定制咨询。">
  <section class="section bg-white">
    <div class="container grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="mt-3 text-4xl font-black md:text-5xl">联系合作</h1>
        <p class="mt-4 text-lg leading-8 text-muted">请通过邮箱发送目标品类、预计数量、销售渠道和包装需求，我们会根据产品方向整理建议。</p>
      </div>
      <div class="rounded-[8px] bg-mist p-6 md:p-8">
        <dl class="grid gap-5">
          <div>
            <dt class="text-sm font-bold text-muted">邮箱</dt>
            <dd class="mt-1 text-2xl font-black"><a class="text-ink no-underline hover:text-herb" href="mailto:buweihao@qq.com">buweihao@qq.com</a></dd>
          </div>
          <div>
            <dt class="text-sm font-bold text-muted">社交链接</dt>
            <dd class="mt-1 text-2xl font-black"><a class="text-ink no-underline hover:text-herb" href="https://baidu.com" rel="noreferrer" target="_blank">baidu.com</a></dd>
          </div>
          <div>
            <dt class="text-sm font-bold text-muted">合作品类</dt>
            <dd class="mt-1 text-lg text-muted">清洁、补水、防晒、抗衰</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';

const products = await getCollection('products');
---

<Layout title="产品 | buweihao" description="浏览 buweihao 清洁、补水、防晒、抗衰护肤产品。">
  <section class="section bg-white">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h1 class="mt-3 text-4xl font-black md:text-5xl">产品</h1>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {products.map((product) => (
          <article class="grid gap-5 rounded-[8px] bg-paper p-5 md:grid-cols-[180px_1fr]">
            <img class="aspect-square rounded-[6px] object-cover" src={product.data.image} alt={product.data.title} />
            <div>
              <p class="m-0 text-sm font-bold text-herb">{product.data.category}</p>
              <h2 class="mt-1 text-2xl font-black">{product.data.title}</h2>
              <p class="mt-2 leading-7 text-muted">{product.data.summary}</p>
              <div class="mt-4 flex flex-wrap gap-2 text-sm">
                <span class="rounded-full bg-white px-3 py-1 font-semibold">{product.data.moq}</span>
                <span class="rounded-full bg-white px-3 py-1 font-semibold">{product.data.leadTime}</span>
              </div>
              <a class="button mt-5" href={`/products/${product.id}/`}>查看详情</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
